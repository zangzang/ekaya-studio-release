  "views": [
    {
      "id": "v_emp_sal",
      "name": "V_EMP_SALARY",
      "sql": "SELECT E.EMP_NO, E.EMP_NM, D.DEPT_NM, G.GRD_NM, S.SAL_AMT\nFROM STD_TBM_EMP E\n  JOIN STD_TBM_DEPT D ON E.DEPT_NO = D.DEPT_NO\n  JOIN STD_TBM_GRD G ON E.GRD_CD = G.GRD_CD\n  LEFT JOIN HR_TBD_SAL S ON E.EMP_NO = S.EMP_NO\nWHERE S.JRNL_NO = (\n  SELECT MAX(S2.JRNL_NO) FROM HR_TBD_SAL S2 WHERE S2.EMP_NO = E.EMP_NO\n)"
    },
    {
      "id": "v_inv",
      "name": "V_INVENTORY",
      "sql": "SELECT I.ITEM_CD, I.ITEM_NM, W.WH_CD, W.WH_NM,\n  COALESCE(IN_Q.SUM_QTY, 0) - COALESCE(OUT_Q.SUM_QTY, 0) AS INV_QTY\nFROM LOG_TBM_ITEM I\n  CROSS JOIN LOG_TBM_WH W\n  LEFT JOIN (\n    SELECT ITEM_CD, WH_CD, SUM(INOUT_QTY) AS SUM_QTY\n    FROM LOG_TBT_INOUT WHERE STS_CD = 'IN' GROUP BY ITEM_CD, WH_CD\n  ) IN_Q ON I.ITEM_CD = IN_Q.ITEM_CD AND W.WH_CD = IN_Q.WH_CD\n  LEFT JOIN (\n    SELECT ITEM_CD, WH_CD, SUM(INOUT_QTY) AS SUM_QTY\n    FROM LOG_TBT_INOUT WHERE STS_CD = 'OUT' GROUP BY ITEM_CD, WH_CD\n  ) OUT_Q ON I.ITEM_CD = OUT_Q.ITEM_CD AND W.WH_CD = OUT_Q.WH_CD"
    },
    {
      "id": "v_jrnl_monthly",
      "name": "V_JRNL_MONTHLY",
      "sql": "SELECT A.ACCT_CD, A.ACCT_NM,\n  EXTRACT(YEAR FROM J.JRNL_DT) AS YYYY,\n  EXTRACT(MONTH FROM J.JRNL_DT) AS MM,\n  SUM(J.JRNL_AMT) AS TOTAL_AMT\nFROM FIN_TBT_JRNL J\n  JOIN FIN_TBM_ACCT A ON J.ACCT_CD = A.ACCT_CD\nGROUP BY A.ACCT_CD, A.ACCT_NM, EXTRACT(YEAR FROM J.JRNL_DT), EXTRACT(MONTH FROM J.JRNL_DT)\nORDER BY YYYY, MM, A.ACCT_CD"
    }
  ]
