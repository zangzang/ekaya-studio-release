  "views": [
    {
      "id": "v_rent_list",
      "name": "V_RENT_LIST",
      "sql": "SELECT R.RENT_DT, M.MBR_NM, B.BOOK_NM, R.DUE_DT, R.RTN_DT, R.RENT_STS\nFROM LIB_TBT_RENT R\n  JOIN LIB_TBM_MBR M ON R.MBR_NO = M.MBR_NO\n  JOIN LIB_TBM_BOOK B ON R.BOOK_NO = B.BOOK_NO\nORDER BY R.RENT_DT DESC"
    },
    {
      "id": "v_overdue",
      "name": "V_OVERDUE",
      "sql": "SELECT M.MBR_NO, M.MBR_NM, M.MBR_TEL, COUNT(*) AS OVRD_CNT\nFROM LIB_TBT_RENT R\n  JOIN LIB_TBM_MBR M ON R.MBR_NO = M.MBR_NO\nWHERE R.RENT_STS = 'RENT' AND R.DUE_DT < CURRENT_DATE\nGROUP BY M.MBR_NO, M.MBR_NM, M.MBR_TEL"
    }
  ]
}
