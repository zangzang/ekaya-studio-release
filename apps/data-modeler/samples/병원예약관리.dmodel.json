    { "id": "r_prsc_med",    "fromEntityId": "e_prsc",  "fromAttrId": "a_prsc_med",     "toEntityId": "e_med",   "toAttrId": "a_med_pk",        "type": "many-to-one" },
    { "id": "r_pay_chart",   "fromEntityId": "e_pay",   "fromAttrId": "a_pay_chart",    "toEntityId": "e_chart", "toAttrId": "a_chart_pk",      "type": "many-to-one" }
  ],
  "tableGroups": [
    { "id": "g_hos", "name": "병원관리", "prefix": "HOS", "color": "#10b981", "position": { "x": 20, "y": 20 }, "size": { "width": 960, "height": 710 }, "namingEnabled": true }
  ],
  "views": [
    {
      "id": "v_appt_today",
      "name": "V_APPT_TODAY",
      "sql": "SELECT A.APPT_DT, A.APPT_TM, P.PTNT_NM, D.DOC_NM, DP.DEPT_NM, A.APPT_STS\nFROM HOS_TBT_APPT A\n  JOIN HOS_TBM_PTNT P ON A.PTNT_NO = P.PTNT_NO\n  JOIN HOS_TBM_DOC D ON A.DOC_NO = D.DOC_NO\n  JOIN HOS_TBM_DEPT DP ON D.DEPT_CD = DP.DEPT_CD\nWHERE A.APPT_DT = CURRENT_DATE\nORDER BY A.APPT_TM"
    },
    {
      "id": "v_chart_summary",
      "name": "V_CHART_SUMMARY",
      "sql": "SELECT C.CHART_NO, P.PTNT_NM, D.DOC_NM, C.SYMP_DESC, DI.DIAG_NM,\n  (SELECT SUM(PAY_AMT) FROM HOS_TBT_PAY PY WHERE PY.CHART_NO = C.CHART_NO) AS TOTAL_PAY\nFROM HOS_TBD_CHART C\n  JOIN HOS_TBM_PTNT P ON C.PTNT_NO = P.PTNT_NO\n  JOIN HOS_TBM_DOC D ON C.DOC_NO = D.DOC_NO\n  LEFT JOIN HOS_TBM_DIAG DI ON C.DIAG_CD = DI.DIAG_CD"
    },
    {
      "id": "v_doc_schedule",
      "name": "V_DOC_SCHEDULE",
      "sql": "SELECT D.DOC_NM, DP.DEPT_NM, A.APPT_DT,\n  COUNT(*) AS APPT_CNT,\n  COUNT(CASE WHEN A.APPT_STS = 'DONE' THEN 1 END) AS DONE_CNT\nFROM HOS_TBM_DOC D\n  JOIN HOS_TBM_DEPT DP ON D.DEPT_CD = DP.DEPT_CD\n  LEFT JOIN HOS_TBT_APPT A ON D.DOC_NO = A.DOC_NO\nGROUP BY D.DOC_NM, DP.DEPT_NM, A.APPT_DT\nORDER BY A.APPT_DT, D.DOC_NM"
    }
  ]
}
